% Syntax Evaluations
\newcommand{\Aexpr}[1]{\ensuremath{\mathcal{A}\syntax{#1}}}
\newcommand{\Aeval}[2]{\ensuremath{\Aexpr{#1}#2}} % Aeval{Syntax}{State}
\newcommand{\Bexpr}[1]{\ensuremath{\mathcal{B}\syntax{#1}}}
\newcommand{\Beval}[2]{\ensuremath{\Bexpr{#1}#2}} % Beval{Syntax}{State}
\newcommand{\Nexpr}[1]{\ensuremath{\mathcal{N}\syntax{#1}}}

% Variable Substitution in State
\newcommand{\substitute}[1]{\ensuremath{\left[ #1 \right]}}
\newcommand{\ssubsCont}[2]{\ensuremath{\substitute{#1 \mapsto #2}}}
\newcommand{\ssubs}[3]{\ensuremath{{#1}\substitute{#2 \mapsto #3}}}
% ssubsAcont : [#2 -> A[[#3]] #1 ]
%            : [y  -> A[[a_0]] s ]
\newcommand{\ssubsAcont}[3]{\ensuremath{\substitute{{#2} \mapsto \Aeval{#3}{#1}}}}
\newcommand{\ssubsBcont}[3]{\ensuremath{\substitute{{#2} \mapsto \Beval{#3}{#1}}}}
% ssubsA     : #1[#2 -> A[[#3 ]] #1 ] 
%            :  s[y  -> A[[a_0]] s  ]
\newcommand{\ssubsA}[3]{\ensuremath{{#1}\ssubsAcont{#1}{#2}{#3}}}
\newcommand{\ssubsB}[3]{\ensuremath{{#1}\ssubsBcont{#1}{#2}{#3}}}
\newcommand{\bracketssubsA}[3]{\left( \ssubsA{#1}{#2}{#3} \right)}
\newcommand{\bracketssubsB}[3]{\left( \ssubsB{#1}{#2}{#3} \right)}


